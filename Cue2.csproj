<Project Sdk="Godot.NET.Sdk/4.6.1">  
<PropertyGroup>  
<TargetFramework>net8.0</TargetFramework>  
<EnableDynamicLoading>true</EnableDynamicLoading>  
<AllowUnsafeBlocks>true</AllowUnsafeBlocks>  
<!-- Rug.Osc is .NET Framework-only; NU1701 is expected and accepted for net8.0. -->
<NoWarn>$(NoWarn);NU1701</NoWarn>
</PropertyGroup>  
<ItemGroup>  
<PackageReference Include="FFmpeg.AutoGen" Version="8.0.0.1" />  
<PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />  
 <PackageReference Include="Rug.Osc" Version="1.2.5" />
<PackageReference Include="SDL3-CS" Version="3.4.2" />  
<PackageReference Include="SDL3-CS.Native" Version="3.4.2" />  
</ItemGroup>  
<ItemGroup>
  <Compile Remove="bin\**" />
</ItemGroup>  
<ItemGroup>
  <EmbeddedResource Remove="bin\**" />
</ItemGroup>
</Project> 
